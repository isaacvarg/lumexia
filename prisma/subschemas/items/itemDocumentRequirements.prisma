// Declares which documents items should have. A rule matches on item type, procurement type and/or
// whether the item is sold; for each file type + issuer, the most specific matching rule wins
// (item type outweighs procurement type, which outweighs the sold condition).
// level: required | optional | excluded (excluded cancels a broader rule)
// scope: item (one current document per item) | lot (one per applicable lot)
// issuer: supplier | internal | any
// sold: null = any item, true = only sold items, false = only items not sold
// lotOrigin (lot scope): received | produced | both; null = by issuer (supplier → received, internal → produced)
model ItemDocumentRequirement {
    id                String           @id @default(uuid())
    itemTypeId        String?          @map("item_type_id")
    procurementTypeId String?          @map("procurement_type_id")
    sold              Boolean?
    fileTypeId        String           @map("file_type_id")
    level             String
    scope             String
    issuer            String
    lotOrigin         String?          @map("lot_origin")
    validForMonths    Int?             @map("valid_for_months")
    minIssuedAt       DateTime?        @map("min_issued_at")
    warnDays          Int              @default(60) @map("warn_days")
    notes             String?
    createdAt         DateTime         @default(now()) @map("created_at")
    updatedAt         DateTime         @updatedAt @map("updated_at")

    itemType        ItemType?        @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
    procurementType ProcurementType? @relation(fields: [procurementTypeId], references: [id], onDelete: Cascade)
    fileType        ItemFileType     @relation(fields: [fileTypeId], references: [id], onDelete: Cascade)

    @@index([itemTypeId])
    @@index([procurementTypeId])
    @@map("item_document_requirements")
}
