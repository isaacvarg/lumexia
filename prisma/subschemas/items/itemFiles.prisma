// issuer: supplier | internal. A newer upload with the same item, file type, issuer, lot and supplier
// sets supersededAt on the previous one. derivedFrom points an internal (rebranded) document at the
// supplier document it was based on, so it can be flagged stale when that source is superseded.
// surrogateFor: this item has no document of its own, so it uses another item's (same File, no copy);
// surrogateReason says why. Flagged stale when that document is superseded. Never for lot documents.
model ItemFile {
    id              String               @id @default(uuid())
    fileTypeId      String               @map("file_type_id")
    fileId          String               @map("file_id")
    itemId String               @map("item_id")
    lotId           String?              @map("lot_id")
    supplierId      String?              @map("supplier_id")
    supplierLotNumber String?            @map("supplier_lot_number")
    purchaseOrderId String?              @map("purchase_order_id")
    issuer          String               @default("supplier")
    issuedAt        DateTime?            @map("issued_at")
    expiresAt       DateTime?            @map("expires_at")
    revision        String?
    supersededAt    DateTime?            @map("superseded_at")
    derivedFromId   String?              @map("derived_from_id")
    surrogateForItemFileId String?       @map("surrogate_for_item_file_id")
    surrogateReason String?              @map("surrogate_reason")
    createdAt       DateTime             @default(now()) @map("created_at")
    updatedAt       DateTime             @updatedAt @map("updated_at")
    fileType        ItemFileType @relation(fields: [fileTypeId], references: [id])
    file            File                 @relation(fields: [fileId], references: [id])
    item   Item        @relation(fields: [itemId], references: [id])
    lot             Lot?                 @relation(fields: [lotId], references: [id])
    supplier        Supplier?            @relation(fields: [supplierId], references: [id])
    purchaseOrder   PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
    derivedFrom     ItemFile?            @relation("ItemFileDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
    derivatives     ItemFile[]           @relation("ItemFileDerivation")
    surrogateFor    ItemFile?            @relation("ItemFileSurrogate", fields: [surrogateForItemFileId], references: [id], onDelete: SetNull)
    surrogates      ItemFile[]           @relation("ItemFileSurrogate")

    @@index([itemId])
    @@index([lotId])
    @@index([supplierLotNumber])
    @@map("item_files")
}
