model ReorderingRule {
    id                      String   @id @default(uuid())
    itemId                  String   @unique @map("item_id")
    thresholdQuantity       Float    @map("threshold_quantity")
    bufferPercent           Float    @default(5) @map("buffer_percent")
    createAuditRequest      Boolean  @default(false) @map("create_audit_request")
    createPurchasingRequest Boolean  @default(false) @map("create_purchasing_request")
    enabled                 Boolean  @default(true)
    createdAt               DateTime @default(now()) @map("created_at")
    updatedAt               DateTime @updatedAt @map("updated_at")
    item                    Item     @relation(fields: [itemId], references: [id])

    @@map("reordering_rules")
}
