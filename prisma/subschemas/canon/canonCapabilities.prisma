model CanonCapability {
    id          String   @id @default(uuid())
    name        String   @unique
    description String?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    userPermissions CanonDataTypeUserPermission[]
    teamPermissions CanonDataTypeTeamPermission[]

    @@map("canon_capabilities")
}
