// One data type for one subject. Created lazily on the first change request,
// so "missing" artifacts are a coverage query, not rows.
model CanonArtifact {
    id                String   @id @default(uuid())
    dataTypeId        String   @map("data_type_id")
    // Postgres treats NULLs as distinct in unique indexes, so uniqueness uses this key instead:
    // "item:<id>", "fp:<id>" or "item:<id>|supplier:<id>"
    subjectKey        String   @map("subject_key")
    itemId            String?  @map("item_id")
    finishedProductId String?  @map("finished_product_id")
    supplierId        String?  @map("supplier_id")
    statusId          String   @map("status_id")
    currentVersionId  String?  @unique @map("current_version_id")
    // linked types: last marker seen from the resolver (accepted marker lives on the version)
    observedMarker    String?  @map("observed_marker")
    observedAt        DateTime? @map("observed_at")
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")

    dataType        CanonDataType         @relation(fields: [dataTypeId], references: [id])
    item            Item?                 @relation(fields: [itemId], references: [id])
    finishedProduct FinishedProduct?      @relation(fields: [finishedProductId], references: [id])
    supplier        Supplier?             @relation(fields: [supplierId], references: [id])
    status          CanonArtifactStatus   @relation(fields: [statusId], references: [id])
    currentVersion  CanonArtifactVersion? @relation("CanonArtifactCurrentVersion", fields: [currentVersionId], references: [id])

    versions       CanonArtifactVersion[] @relation("CanonArtifactVersions")
    changeRequests CanonChangeRequest[]
    events         CanonArtifactEvent[]

    @@unique([dataTypeId, subjectKey])
    @@index([itemId])
    @@index([finishedProductId])
    @@map("canon_artifacts")
}
