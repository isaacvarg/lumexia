model RecordStatus {
    id                     String                  @id @default(uuid())
    name                   String
    bgColor                String                  @default("#000000") @map("bg_color")
    textColor              String                  @default("#ffffff") @map("text_color")
    description            String
    createdAt              DateTime                @default(now()) @map("created_at")
    updatedAt              DateTime                @updatedAt @map("updated_at")
    itemConsumerContainers ItemConsumerContainer[]
    purchaseOrders          PurchaseOrder[]
    items Item[]
    suppliers Supplier[]
    finishedProductAuxiliaries FinishedProductAuxiliary[]
    batchSteps             BatchStep[]
    stepInstructions       StepInstruction[]
    stepAddendums          StepAddendum[]
    stepActionables        StepActionable[]
    billOfMaterials        BillOfMaterial[]
    stepEquipment          StepEquipment[]

    @@map("record_statuses")
}
