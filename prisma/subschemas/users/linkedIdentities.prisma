// A chat identity (e.g. a WhatsApp number) proven to belong to a Lumexia user. Agents with a key that may
// act for linked users (Hermes) pass the sender's identity, and actions like approving pricing are recorded
// as that user rather than the key's owner.
model LinkedIdentity {
    id         String   @id @default(uuid())
    userId     String   @map("user_id")
    channel    String
    externalId String   @map("external_id")
    // the key the link code was redeemed with
    apiKeyId   String?  @map("api_key_id")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

    @@unique([channel, externalId])
    @@index([userId])
    @@map("linked_identities")
}

// A one-time code a user creates in Lumexia and sends to the agent from the identity they want to link.
// Redeeming it proves they control both the Lumexia account and the chat identity. Only a hash is stored.
model IdentityLinkCode {
    id        String    @id @default(uuid())
    userId    String    @map("user_id")
    channel   String
    codeHash  String    @unique @map("code_hash")
    expiresAt DateTime  @map("expires_at")
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("identity_link_codes")
}
