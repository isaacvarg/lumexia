// The first result of an MCP write made with a given idempotency key, so an agent that retries
// (a timeout, a re-run seeding script) gets the same answer instead of creating the record twice.
// Keys are scoped to the API key that used them.
model ApiIdempotencyKey {
    id          String   @id @default(uuid())
    apiKeyId    String   @map("api_key_id")
    key         String
    tool        String
    // hash of the arguments, so reusing a key for a different request is refused instead of answered wrongly
    requestHash String   @map("request_hash")
    response    Json
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

    @@unique([apiKeyId, key])
    @@map("api_idempotency_keys")
}
