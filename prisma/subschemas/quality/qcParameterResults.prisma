model QcParameterResult {
    id                    String                     @id @default(uuid())
    qcRecordId            String                     @map("qc_record_id")
    qcItemParameterId     String                     @map("qc_item_parameter_id")
    value                 String
    runNumber             Int                        @default(1) @map("run_number")
    reviewState       String    @default("accepted") @map("review_state")
    reviewReasons     Json?     @map("review_reasons")
    source            String    @default("manual")
    sourceItemFileId  String?   @map("source_item_file_id")
    sourceFactId      String?   @map("source_fact_id")
    computedOutcome   String?   @map("computed_outcome")
    suggestedOutcome  String?   @map("suggested_outcome")
    supplierOutcome   String?   @map("supplier_outcome")
    confirmedById     String?   @map("confirmed_by_id")
    confirmedAt       DateTime? @map("confirmed_at")
    createdAt             DateTime                   @default(now()) @map("created_at")
    updatedAt             DateTime                   @updatedAt @map("updated_at")
    qcRecord              QcRecord                   @relation(fields: [qcRecordId], references: [id])
    qcItemParameter       QcItemParameter            @relation(fields: [qcItemParameterId], references: [id])
    parameterInputResults QcParameterInputResult[]

    @@unique([qcRecordId, qcItemParameterId, runNumber])
    @@map("qc_parameter_results")
}
