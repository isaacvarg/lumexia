model ExperimentVariant {
    id           String   @id @default(uuid())
    experimentId String   @map("experiment_id")
    sourceMbprId String?  @map("source_mbpr_id")
    label        String
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    experiment  Experiment                    @relation(fields: [experimentId], references: [id])
    sourceMbpr  MasterBatchProductionRecord?  @relation(fields: [sourceMbprId], references: [id])
    materials   ExperimentVariantMaterial[]
    samples     ExperimentSample[]
    methodSteps ExperimentVariantMethodStep[]

    @@map("experiment_variants")
}
