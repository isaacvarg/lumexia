model ExperimentVariantMaterial {
    id                  String   @id @default(uuid())
    experimentVariantId String   @map("experiment_variant_id")
    itemId              String   @map("item_id")
    concentration       Float
    sequence            Int      @default(0)
    phase               String?
    createdAt           DateTime @default(now()) @map("created_at")
    updatedAt           DateTime @updatedAt @map("updated_at")

    experimentVariant ExperimentVariant                @relation(fields: [experimentVariantId], references: [id])
    item              Item                              @relation(fields: [itemId], references: [id])
    preparationSteps  ExperimentSamplePreparationStep[]

    @@map("experiment_variant_materials")
}
