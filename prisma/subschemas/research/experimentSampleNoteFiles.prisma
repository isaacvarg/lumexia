model ExperimentSampleNoteFile {
    id                     String   @id @default(uuid())
    experimentSampleNoteId String   @map("experiment_sample_note_id")
    fileId                 String   @map("file_id")
    createdAt              DateTime @default(now()) @map("created_at")
    updatedAt              DateTime @updatedAt @map("updated_at")

    experimentSampleNote ExperimentSampleNote @relation(fields: [experimentSampleNoteId], references: [id])
    file                 File                 @relation(fields: [fileId], references: [id])

    @@map("experiment_sample_note_files")
}
