model PricingExamination {
    id                              String                         @id @default(uuid())
    statusId                        String?                        @map("status_id")
    examinedItemId                  String                         @map("examined_item_id")
    userId                          String                         @map("user_id")
    approvedById                    String?                        @map("approved_by_id")
    approvedAt                      DateTime?                      @map("approved_at")
    rejectedById                    String?                        @map("rejected_by_id")
    rejectedAt                      DateTime?                      @map("rejected_at")
    rejectedFromId                  String?                        @map("rejected_from_id")
    createdAt                       DateTime                       @default(now()) @map("created_at")
    updatedAt                       DateTime                       @updatedAt @map("updated_at")
    examinedItem                    Item                           @relation(fields: [examinedItemId], references: [id])
    user                            User                           @relation("PricingExaminationDrafter", fields: [userId], references: [id])
    approvedBy                      User?                          @relation("PricingExaminationApprovedBy", fields: [approvedById], references: [id])
    rejectedBy                      User?                          @relation("PricingExaminationRejectedBy", fields: [rejectedById], references: [id])
    rejectedFrom                    PricingExamination?            @relation("PricingExaminationRejectionLineage", fields: [rejectedFromId], references: [id])
    replacedBy                      PricingExamination[]           @relation("PricingExaminationRejectionLineage")
    status                          PricingExaminationStatus?      @relation(fields: [statusId], references: [id])
    itemPricingDataArchive          ItemPricingDataArchive[]
    consumerContainerArchive        ConsumerContainerArchive[]
    filledConsumerContainerArchives ItemConsumerContainerArchive[]
    validation                      PricingExaminationValidation[]
    producedPricingDataArchives     ProducedPricingDataArchive[]

    @@map("pricing_examinations")
}
