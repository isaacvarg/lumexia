  name        String       @map("name")
  description String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  userConfigs UserConfig[]

  @@map("user_config_groups")
}

model UserConfig {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  configGroupId String          @map("config_group_id")
  name          String
  value         String
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  user          User            @relation(fields: [userId], references: [id])
  configGroup   UserConfigGroup @relation(fields: [configGroupId], references: [id])

  @@map("user_configs")
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  userRoleId String   @map("user_role_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  userRole UserRole @relation(fields: [userRoleId], references: [id])

  @@map("user_role_assignments")
}

model UserRole {
  id                 String               @id @default(uuid())
  name               String
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  StepActionableType StepActionableType[]
  UserRoleAssignment UserRoleAssignment[]

  @@map("user_roles")
}

model User {
  id                               String                            @id @default(cuid())
  name                             String?
  email                            String?                           @unique
  emailVerified                    DateTime?                         @map("email_verified")
  image                            String?
  disabled                         Boolean                           @default(false)
  accounts                         Account[]
  sessions                         Session[]
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  purchaseOrders                   PurchaseOrder[]
  transactions                     Transaction[]
  purchaseOrderNotes               PurchaseOrderNote[]
  activityLogs                     ActivityLog[]
  userConfigs                      UserConfig[]
  purchasingRequests               PurchasingRequest[]
  requestNotes                     RequestNote[]
  auditRequests                    AuditRequest[]
  auditRequestNotes                AuditRequestNote[]
  pricingExaminations              PricingExamination[]              @relation("PricingExaminationDrafter")
  pricingExaminationsApproved      PricingExamination[]              @relation("PricingExaminationApprovedBy")
  pricingExaminationsRejected      PricingExamination[]              @relation("PricingExaminationRejectedBy")
  qcRecords                        QcRecord[]
  qcRecordNotes                    QcRecordNote[]
  qcAuditLog                       QcAuditLog[]
  files                            File[]
  poAccountingAuditLogd            PoAccountingAuditLog[]
  generalRequests                  GeneralRequest[]
  generalRequestNotes              GeneralRequestNote[]
  experimentsAsPrimaryInvestigator Experiment[]
  experimentNotes                  ExperimentNote[]
  preparedExperimentSamples        ExperimentSample[]                @relation("ExperimentSamplePreparedBy")
  experimentSamplePreparationSteps ExperimentSamplePreparationStep[] @relation("ExperimentSamplePreparationStepCompletedBy")
  experimentSampleNotes            ExperimentSampleNote[]
  experimentSampleMeasurements     ExperimentSampleMeasurement[]     @relation("ExperimentSampleMeasurementCreatedBy")
  PoAccountingNote                 PoAccountingNote[]
  PricingExaminationNote           PricingExaminationNote[]
  CanonArtifactEvent               CanonArtifactEvent[]
  CanonChangeRequestReview         CanonChangeRequestReview[]
  CanonChangeRequest               CanonChangeRequest[]
  CanonDataTypeUserPermission      CanonDataTypeUserPermission[]
  CanonTeamMember                  CanonTeamMember[]
  DiscrepancyAuditItemNote         DiscrepancyAuditItemNote[]
  InventoryAudit                   InventoryAudit[]
  LotNote                          LotNote[]
  ItemNote                         ItemNote[]
  BprBillOfMaterials               BprBillOfMaterials[]
  BprNote                          BprNote[]
  BprStaging                       BprStaging[]
  BprStagingDenial                 BprStagingDenial[]
  BprStagingVerification           BprStagingVerification[]
  BprStatusTransition              BprStatusTransition[]
  BprStepActionableCompletion      BprStepActionableCompletion[]
  BprStepActionableVerification    BprStepActionableVerification[]
  MbprNote                         MbprNote[]
  PoPublicNote                     PoPublicNote[]
  PoSupplierNote                   PoSupplierNote[]
  ApiKey                           ApiKey[]
  Authenticator                    Authenticator[]
  UserRoleAssignment               UserRoleAssignment[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
